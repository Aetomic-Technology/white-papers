# Copy to .env locally or export these variables through your shell/CI environment.
# NEVER commit credentials.

# Supported values: azure-openai-chat | openai-compatible-chat
LB_PROVIDER=azure-openai-chat

# Full POST endpoint for a chat-completions compatible deployment.
# Azure example shape only; supply the actual endpoint and api-version used by your deployment.
# LB_MODEL_ENDPOINT=https://YOUR_RESOURCE.openai.azure.com/openai/deployments/YOUR_DEPLOYMENT/chat/completions?api-version=YOUR_API_VERSION
LB_MODEL_ENDPOINT=

# Model/deployment label recorded in the manifest for provenance.
LB_MODEL_NAME=

# Credential. For Azure this is sent as `api-key`; for OpenAI-compatible endpoints as Bearer auth.
LB_API_KEY=

# Optional experiment label. Defaults to PRE-FRONTIER-BASELINE.
LB_ARCHITECTURE_LABEL=PRE-FRONTIER-BASELINE
